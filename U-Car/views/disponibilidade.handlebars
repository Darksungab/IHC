<a href="/veiculos/{{veiculo.id}}" class="btn-voltar">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 256 256" aria-hidden="true" fill="currentColor"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
    <span>Voltar</span>
</a>

<div class="card">
    <h1>Disponibilidade e Valores</h1>
    <p class="subtitulo">{{veiculo.nome}} {{veiculo.ano}} — selecione o período</p>

    <form method="post" action="/veiculos/{{veiculo.id}}/disponibilidade" class="disponibilidade-form">
        <div class="campo">
            <label for="retirada">Retirada:</label>
            <input type="date" id="retirada" name="retirada" min="{{hojeFormatado}}" required>
        </div>

        <div class="campo">
            <label for="devolucao">Devolução:</label>
            <input type="date" id="devolucao" name="devolucao" min="{{hojeFormatado}}" required>
        </div>

        <button type="submit" class="btn-primario">Verificar</button>
    </form>
    {{#if erro}}
    <p class="mensagem-erro">{{erro}}</p>
    {{/if}}

    {{#if dias}}
    <dl class="resultado">
        <dt>Diária:</dt>
        <dd>R$ {{veiculo.diaria}}</dd>
        <dt>Quantidade de dias:</dt>
        <dd>{{dias}}</dd>
        <dt>Subtotal:</dt>
        <dd>R$ {{subtotal}}</dd>
        <dt>Taxa de serviço:</dt>
        <dd>R$ {{taxaServico}}</dd>
        <dt class="total-label">Total:</dt>
        <dd class="total-valor">R$ {{total}}</dd>
    </dl>
    {{/if}}
</div>
