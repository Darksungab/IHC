<h1 class="titulo-pg">Veículos</h1>

<ul class="lista-veiculos">
    {{#each veiculos}}
    <li>
        <article class="veiculo-card">
            <img src="{{foto}}" alt="{{nome}}" class="veiculo-card-foto">
            <h2>{{nome}} {{ano}}</h2>
            <dl>
                <dt>Combustível:</dt>
                <dd>{{combustivel}}</dd>
                <dt>Diária:</dt>
                <dd>R$ {{diaria}}</dd>
            </dl>
            <a href="/veiculos/{{id}}">Ver carro</a>
        </article>
    </li>
    {{/each}}
</ul>
